{
  "repository": "ha-homelab/sensing-evidence-kit",
  "mode": "release",
  "default_branch": "main",
  "visibility": "public",
  "version_file": "version",
  "validation_workflows": [
    "tests.yml",
    "security.yml",
    "documentation.yml"
  ],
  "artifact_pattern": "release-assets*",
  "local_checks": [
    "uv run --frozen --extra dev --extra record sh scripts/check.sh"
  ],
  "notes": [
    "Examples and screenshots are synthetic. Site configuration, credentials, real observations and private Git history are excluded.",
    "Offline tests cover simulated boundaries. A beta release does not establish compatibility with every camera, network or Home Assistant installation.",
    "Documentation-only routing preserves full validation for semantic package readme metadata: README.md. Ordinary archive copies remain documentation-scoped.",
    "The configured release-note file remains a full-validation input so its current release section, upgrade notes and security notes are checked.",
    "Documentation-consuming checks remain active on documentation-only PRs through the lightweight documentation validator."
  ],
  "release_notes": "CHANGELOG.md",
  "single_entry_ci": true,
  "versioning": {
    "schema": 1,
    "promotion": "promote-bytes",
    "files": [
      {
        "path": "version",
        "format": "text",
        "value": "package",
        "ecosystem": "pep440"
      },
      {
        "path": "pyproject.toml",
        "format": "toml",
        "field": "project.version",
        "value": "package",
        "ecosystem": "pep440"
      },
      {
        "path": "src/sensing_evidence/__init__.py",
        "format": "python",
        "field": "__version__",
        "value": "package",
        "ecosystem": "pep440"
      },
      {
        "path": "uv.lock",
        "format": "uv-lock",
        "package": "sensing-evidence-kit",
        "value": "package",
        "ecosystem": "pep440"
      }
    ],
    "artifacts": [
      {
        "path": "sensing_evidence_kit-*.whl",
        "format": "wheel",
        "package": "sensing-evidence-kit",
        "value": "package",
        "ecosystem": "pep440"
      },
      {
        "path": "sensing_evidence_kit-*.tar.gz",
        "format": "sdist",
        "package": "sensing-evidence-kit",
        "value": "package",
        "ecosystem": "pep440"
      }
    ],
    "toolkit_revision": "f0bf0ec4921619f0de09ecd3eaa5e8673e4f9695"
  },
  "toolkit_revision": "f0bf0ec4921619f0de09ecd3eaa5e8673e4f9695",
  "sign_releases": true,
  "fuzzing": {
    "toolkit_ref": "d4b21d156067ce58f89f89149bfad545e1889ae7"
  },
  "change_scope": {
    "documentation_paths": [
      "GOVERNANCE.md",
      "ROADMAP.md"
    ],
    "required_paths": [
      "CHANGELOG.md",
      "README.md"
    ],
    "always_validate_workflows": [
      "security.yml",
      "documentation.yml"
    ]
  }
}
